#!/bin/bash

BACKUP_DIR="$HOME/backups"
DATE=$(date +%Y-%m-%d)

mkdir -p "$BACKUP_DIR"

tar -czf "$BACKUP_DIR/nginx-$DATE.tar.gz" \
    /etc/nginx \
    /usr/share/nginx/html

# Delete Nginx backups older than {{ nginx_backup_retention_days }} days
find "$BACKUP_DIR" -type f -name "nginx-*.tar.gz" -mtime +{{ nginx_backup_retention_days }} -delete

echo "Backup complete: $BACKUP_DIR/nginx-$DATE.tar.gz"
